# ==============================================================================
# i-AdminConnect Apache / LiteSpeed Configuration
# ==============================================================================

<IfModule mod_rewrite.c>
    RewriteEngine On

    # 1. Enforce Canonical Domain: Redirect www.iadminconnect.com -> https://iadminconnect.com
    RewriteCond %{HTTP_HOST} ^www\.iadminconnect\.com$ [NC]
    RewriteRule ^(.*)$ https://iadminconnect.com/$1 [R=301,L]

    # 2. Force HTTPS (Production Only - exclude localhost and local IP addresses)
    RewriteCond %{HTTPS} off
    RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:\d+)?$ [NC]
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
</IfModule>

# Disable Directory Browsing
Options -Indexes

# 3. HTTP Security Headers (OWASP Recommended)
<IfModule mod_headers.c>
    # Protect against Clickjacking attacks
    Header always set X-Frame-Options "SAMEORIGIN"
    # Prevent MIME-type sniffing
    Header always set X-Content-Type-Options "nosniff"
    # Cross-site scripting filter
    Header always set X-XSS-Protection "1; mode=block"
    # Strict Referrer Policy to protect URL tokens
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# 4. Protect Sensitive Files & Directories
<FilesMatch "^(\.git|\.env|composer\.|package\.|\.ht)">
    Order allow,deny
    Deny from all
</FilesMatch>

# Upload file size settings (for hosts supporting php_value in .htaccess)
<IfModule mod_php.c>
    php_value upload_max_filesize 20M
    php_value post_max_size 25M
</IfModule>
<IfModule mod_php7.c>
    php_value upload_max_filesize 20M
    php_value post_max_size 25M
</IfModule>
<IfModule mod_php8.c>
    php_value upload_max_filesize 20M
    php_value post_max_size 25M
</IfModule>

# ==============================================================================
# 5. Browser Caching & Gzip Compression Optimization (Phase 4 Revisions)
# ==============================================================================

# Enable Gzip / Deflate Compression (Reduces bandwidth payload by up to 70%)
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript
    AddOutputFilterByType DEFLATE application/javascript application/x-javascript application/json
    AddOutputFilterByType DEFLATE application/xml application/xhtml+xml application/rss+xml
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# Enable Browser Asset Caching via mod_expires
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"

    # Images & Media (1 Year)
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"

    # Stylesheets & Scripts (1 Month)
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType text/javascript "access plus 1 month"

    # Web Fonts (1 Year)
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType application/font-woff "access plus 1 year"
    ExpiresByType application/font-woff2 "access plus 1 year"

    # Dynamic PHP Pages & API Endpoints (Real-time live data - No Cache)
    ExpiresByType text/html "access plus 0 seconds"
    ExpiresByType application/json "access plus 0 seconds"
</IfModule>

# Explicit Cache-Control & Pragma Headers via mod_headers
<IfModule mod_headers.c>
    # 1 Year Cache for Static Images and Fonts
    <FilesMatch "\.(ico|jpe?g|png|gif|webp|svg|woff2?|ttf|eot)$">
        Header set Cache-Control "max-age=31536000, public, immutable"
    </FilesMatch>

    # 1 Month Cache for Stylesheets & JavaScript
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "max-age=2592000, public"
    </FilesMatch>

    # Ensure Dynamic PHP files are never cached by browser
    <FilesMatch "\.(php)$">
        Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
        Header set Pragma "no-cache"
    </FilesMatch>
</IfModule>
